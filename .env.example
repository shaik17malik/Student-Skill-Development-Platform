APP_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ssp_db
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional admin self-sign-up; keep the real key private in server/.env.
ADMIN_SIGNUP_KEY=
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
